{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Elyra Design Tokens",
  "version": "1.0.0",
  "colors": {
    "light": {
      "surface": "#FFFFFF",
      "surfaceVariant": "#F1F3F5",
      "onSurface": "#1A1D20",
      "onSurfaceVariant": "#5F6368",
      "primary": "#2D5BFF",
      "onPrimary": "#FFFFFF",
      "secondary": "#4A5568",
      "outline": "#E2E8F0",
      "success": "#10B981",
      "warning": "#F59E0B",
      "error": "#EF4444"
    },
    "dark": {
      "surface": "#121417",
      "surfaceVariant": "#1B1E22",
      "onSurface": "#E8EAED",
      "onSurfaceVariant": "#9AA0A6",
      "primary": "#4B73FF",
      "onPrimary": "#FFFFFF",
      "secondary": "#A0AEC0",
      "outline": "#2D3748",
      "success": "#34D399",
      "warning": "#FBBF24",
      "error": "#F87171"
    },
    "amoled": {
      "surface": "#000000",
      "surfaceVariant": "#0D0E10",
      "onSurface": "#F1F3F4",
      "onSurfaceVariant": "#9AA0A6",
      "primary": "#4B73FF",
      "onPrimary": "#FFFFFF",
      "secondary": "#CBD5E0",
      "outline": "#26292E",
      "success": "#34D399",
      "warning": "#FBBF24",
      "error": "#F87171"
    }
  },
  "typography": {
    "fontFamily": "Inter, Roboto Flex, sans-serif",
    "scales": {
      "display": { "fontSize": 36, "lineHeight": 44, "fontWeight": 600 },
      "title": { "fontSize": 22, "lineHeight": 28, "fontWeight": 500 },
      "subtitle": { "fontSize": 17, "lineHeight": 24, "fontWeight": 500 },
      "body": { "fontSize": 15, "lineHeight": 22, "fontWeight": 400 },
      "label": { "fontSize": 13, "lineHeight": 18, "fontWeight": 500 },
      "caption": { "fontSize": 12, "lineHeight": 16, "fontWeight": 400 }
    }
  },
  "spacing": {
    "base": 4,
    "scale": [4, 8, 12, 16, 20, 24, 32, 48]
  },
  "radii": {
    "small": 8,
    "card": 16,
    "sheet": 28,
    "pill": 9999
  },
  "motion": {
    "durations": {
      "fast": 100,
      "normal": 200,
      "emphasized": 300
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.0, 0.0, 1.0)",
      "decelerate": "cubic-bezier(0.0, 0.0, 0.2, 1.0)",
      "accelerate": "cubic-bezier(0.4, 0.0, 1.0, 1.0)"
    }
  }
}
