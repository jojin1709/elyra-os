<?xml version="1.0" encoding="utf-8"?>
<!-- Elyra OS SystemUI Configuration Overlays -->
<resources>
    <!-- Quick Settings columns and rows for calm, readable hierarchy -->
    <integer name="quick_settings_num_columns">2</integer>
    <integer name="quick_settings_max_rows">4</integer>
    <integer name="quick_settings_min_num_tiles">6</integer>

    <!-- Corner radius for notification and QS cards -->
    <dimen name="notification_corner_radius">16dp</dimen>
    <dimen name="qs_corner_radius">16dp</dimen>

    <!-- Support smart replies and notification actions -->
    <bool name="config_smart_replies_in_notifications_enabled">true</bool>

    <!-- Allow status bar burn-in protection shifts on AMOLED screens -->
    <bool name="config_statusBarBurnInProtection">true</bool>
</resources>
